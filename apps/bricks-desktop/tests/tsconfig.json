{
	"extends": "../tsconfig.app.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["node"],
		"typeRoots": ["../node_modules/@types"],
		"skipLibCheck": true,
		"ignoreDeprecations": "6.0"
	},
	"include": [
		"unit/**/*.ts",
		"../src/lib/state/*.ts",
		"../src/lib/features/commands/*.ts",
		"../src/lib/ipc/*.ts",
		"../src/lib/ipc/bindings/*.ts"
	]
}
