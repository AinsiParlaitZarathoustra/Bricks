{
  "description": "Code questions on the Bricks repository with known answers. `expected` lists (path, text of the line) pairs: robust to line shifts. Baseline: what an agent does without CodeScout (the real Grep tool, then Read of the first matching files).",
  "cases": [
    {"id": "def-estimate_text", "category": "definition", "query": {"text": "estimate_text", "intent": "find_symbol"},
     "baseline": {"pattern": "\\bestimate_text\\b", "reads": 3},
     "expected": [{"path": "crates/cersei-types/src/tokens.rs", "contains": "pub fn estimate_text"}]},
    {"id": "def-child_tools", "category": "definition", "query": {"text": "child_tools", "intent": "find_symbol"},
     "baseline": {"pattern": "\\bchild_tools\\b", "reads": 3},
     "expected": [{"path": "crates/cersei-agent/src/subagent.rs", "contains": "pub fn child_tools"}]},
    {"id": "def-parse_locations", "category": "definition", "query": {"text": "parse_locations", "intent": "find_symbol"},
     "baseline": {"pattern": "\\bparse_locations\\b", "reads": 3},
     "expected": [{"path": "crates/cersei-lsp/src/client.rs", "contains": "pub fn parse_locations"}]},
    {"id": "def-build_matcher", "category": "definition", "query": {"text": "build_matcher", "intent": "find_symbol"},
     "baseline": {"pattern": "\\bbuild_matcher\\b", "reads": 3},
     "expected": [{"path": "crates/bricks-semantic/src/lexical.rs", "contains": "pub fn build_matcher"}]},
    {"id": "qualified-registry-global", "category": "definition", "query": {"text": "SemanticRegistry::global", "intent": "find_symbol"},
     "baseline": {"pattern": "\\bglobal\\b", "reads": 3},
     "expected": [{"path": "crates/bricks-semantic/src/registry.rs", "contains": "pub fn global"}]},
    {"id": "ambiguous-estimate_tokens", "category": "ambiguous", "query": {"text": "estimate_tokens", "intent": "find_symbol"},
     "baseline": {"pattern": "\\bestimate_tokens\\b", "reads": 3},
     "expected": [{"path": "crates/cersei-agent/src/compact.rs", "contains": "pub fn estimate_tokens"},
                  {"path": "crates/cersei-agent/src/context_analyzer.rs", "contains": "fn estimate_tokens"}]},
    {"id": "ambiguous-from_bricks_toml", "category": "ambiguous", "query": {"text": "from_bricks_toml", "intent": "find_symbol"},
     "baseline": {"pattern": "\\bfrom_bricks_toml\\b", "reads": 3},
     "expected": [{"path": "crates/cersei-agent/src/control/settings.rs", "contains": "fn from_bricks_toml"},
                  {"path": "crates/cersei-compression/src/config.rs", "contains": "fn from_bricks_toml"},
                  {"path": "crates/cersei-memory/src/structured/config.rs", "contains": "fn from_bricks_toml"},
                  {"path": "crates/cersei-web/src/config.rs", "contains": "fn from_bricks_toml"}]},
    {"id": "text-search-rejection", "category": "text", "query": {"text": "nothing to search for", "intent": "text_search"},
     "baseline": {"pattern": "nothing to search for", "reads": 1},
     "expected": [{"path": "crates/cersei-agent/src/control/controller.rs", "contains": "nothing to search for"}]},
    {"id": "text-content-length", "category": "text", "query": {"text": "Missing Content-Length", "intent": "text_search"},
     "baseline": {"pattern": "Missing Content-Length", "reads": 1},
     "expected": [{"path": "crates/cersei-lsp/src/jsonrpc.rs", "contains": "Missing Content-Length"}]},
    {"id": "refs-notify_workspace_changed", "category": "references", "query": {"text": "notify_workspace_changed", "intent": "references"},
     "baseline": {"pattern": "\\bnotify_workspace_changed\\b", "reads": 3},
     "expected": [{"path": "crates/cersei-agent/src/runner.rs", "contains": "notify_workspace_changed(&tool_ctx)"}]},
    {"id": "refs-child_tools", "category": "references", "query": {"text": "child_tools", "intent": "references"},
     "baseline": {"pattern": "\\bchild_tools\\b", "reads": 3},
     "expected": [{"path": "crates/cersei-agent/src/delegate.rs", "contains": "child_tools("},
                  {"path": "crates/cersei-agent/src/agent_tool.rs", "contains": "child_tools("},
                  {"path": "crates/cersei-agent/src/subagent.rs", "contains": "child_tools(tools"}]}
  ]
}
