/target
**/target
# The workspace's /Cargo.lock is versioned: Bricks ships a binary, and builds
# are checked with `--locked`. A consumer outside the workspace keeps its own
# lock locally (it resolves the same crates through path dependencies).
/examples/**/Cargo.lock
.DS_Store
*.swp
*.swo
*~
.env
.env.local

# coding agents
third-party
.claude

bench/runner-*.sh

# ─── SECRET / ARTIFACT HYGIENE ─────────────────────────────────────────────
# Bench run artifacts — logs, per-question rows, terminal-bench JSONL —
# have historically captured API keys in reqwest error messages and Google
# `?key=` query strings. Do NOT commit any of them. Re-run the bench to
# regenerate locally; the numbers are reproducible.
bench/long-mem/results/
bench/long-mem/results-*/
bench/long-mem/*.log
bench/long-mem/full-*-run*.log
bench/long-mem/data/
bench/term-bench/tb-results/
bench/term-bench/*.log
bench/term-bench/failure_patterns.txt
bench/**/*.log
bench/**/abstract-output.jsonl

# Anything under a bench runner that historically hardcoded keys.
bench/**/runner-*.sh
bench/**/runner-*.bash
# Sanitized example (reads the key from the environment); scanned by
# scripts/check_secrets.py like any tracked file.
!bench/term-bench/runner-google.sh

# Belt-and-braces: anything that looks like a secret-bearing file.
.env
.env.*
!.env.example
*.secret
*.secret.*
credentials.json
credentials.*.json

# Python venvs created by bench harnesses.
bench/**/.venv/
bench/**/__pycache__/
**/__pycache__/
*.pyc

# Linux bench binaries are build outputs; see bench/term-bench/BINARIES.md.
bench/term-bench/abstract-linux-*
bench/term-bench/tbench-agent-linux-*

# Atlas editor
.atlas

# Google Vertex service-account key (NEVER commit)
service-account.json
*service-account*.json


# Graphify Output
/graphify-out/

# Obsidian Vault (has its own git)
/oslo-vault/

# Temp Folder For test and dump
/joy
TOOL-CALLING-RELIABILITY.md
